generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  passwordHash   String
  displayName    String
  avatar         String?
  status         String          @default("ACTIVE")
  disabledReason String?
  roles          UserRole[]
  kycApplications KycApplication[] @relation("Applicant")
  kycReviews     KycReview[]     @relation("Reviewer")
  tickets        Ticket[]        @relation("TicketRequester")
  ticketMessages TicketMessage[] @relation("TicketSender")
  auditLogs      AuditLog[]      @relation("AuditActor")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Role {
  id    String     @id @default(cuid())
  code  String     @unique
  name  String
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KycApplication {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation("Applicant", fields: [userId], references: [id])
  fullName     String
  idNumber     String
  documentType String
  phone        String
  status       String         @default("PENDING")
  submittedAt  DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  documents    KycDocument[]
  reviews      KycReview[]
  appeals      KycAppeal[]
}

model KycDocument {
  id            String         @id @default(cuid())
  applicationId String
  application   KycApplication @relation(fields: [applicationId], references: [id])
  type          String
  url           String
  createdAt     DateTime       @default(now())
}

model KycReview {
  id            String         @id @default(cuid())
  applicationId String
  application   KycApplication @relation(fields: [applicationId], references: [id])
  action        String
  reviewerId    String
  reviewer      User           @relation("Reviewer", fields: [reviewerId], references: [id])
  comment       String?
  createdAt     DateTime       @default(now())
}

model KycAppeal {
  id              String         @id @default(cuid())
  applicationId   String
  application     KycApplication @relation(fields: [applicationId], references: [id])
  status          String         @default("PENDING")
  reason          String?
  decisionComment String?
  handledById     String?
  handledBy       User?          @relation(fields: [handledById], references: [id])
  handledAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Ticket {
  id           String         @id @default(cuid())
  requesterId  String
  requester    User           @relation("TicketRequester", fields: [requesterId], references: [id])
  subject      String
  category     String
  status       String         @default("WAITING")
  tags         String?
  internalNote String?
  messages     TicketMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  senderId  String
  sender    User     @relation("TicketSender", fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       String?
  createdAt  DateTime @default(now())
}
