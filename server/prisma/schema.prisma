generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  username             String            @unique
  passwordHash         String
  displayName          String
  avatar               String?
  roles                UserRole[]
  applications         KycApplication[]  @relation("Applicant")
  assignedApplications KycApplication[]  @relation("Auditor")
  auditRecords         KycAuditRecord[]  @relation("AuditorRecords")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Role {
  id    String     @id @default(cuid())
  code  String     @unique
  name  String
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model KycApplication {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation("Applicant", fields: [userId], references: [id])
  fullName          String
  idNumber          String
  nationality       String?
  status            String          @default("PENDING")
  submittedAt       DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  assignedAuditorId String?
  assignedAuditor   User?           @relation("Auditor", fields: [assignedAuditorId], references: [id])
  documents         KycDocument[]
  auditRecords      KycAuditRecord[]
}

model KycDocument {
  id            String         @id @default(cuid())
  applicationId String
  application   KycApplication @relation(fields: [applicationId], references: [id])
  type          String
  url           String
}

model KycAuditRecord {
  id            String          @id @default(cuid())
  applicationId String
  application   KycApplication  @relation(fields: [applicationId], references: [id])
  action        String
  auditorId     String
  auditor       User            @relation("AuditorRecords", fields: [auditorId], references: [id])
  comment       String?
  createdAt     DateTime        @default(now())
}
