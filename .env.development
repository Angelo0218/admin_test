# Use hash-based routing
VITE_USE_HASH = 'true'

# Public base path
VITE_PUBLIC_PATH = '/'

# Axios base URL (local backend via proxy)
VITE_AXIOS_BASE_URL = '/api/v1'

# Proxy target (optional for local backend)
VITE_PROXY_TARGET = 'http://localhost:8085/api'

# Permission source: static (frontend only) / remote (backend)
VITE_PERMISSION_MODE = 'remote'
